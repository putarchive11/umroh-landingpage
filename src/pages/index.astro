  <script>
    const chapBox = document.querySelector('#chap-carousel');
    const chapTrack = document.querySelector('#chap-track');
    if (chapBox && chapTrack) {
      const cards = chapTrack.querySelectorAll('.chap-card');
      const prev = document.querySelector('#chap-prev');
      const next = document.querySelector('#chap-next');
      const count = document.querySelector('#chap-count');
      const bar = document.querySelector('#chap-bar');
      const pad = (n) => String(n);
      const step = () => (cards[1] ? cards[1].offsetLeft - cards[0].offsetLeft : chapTrack.clientWidth);
      const maxScroll = () => chapTrack.scrollWidth - chapTrack.clientWidth;
      const current = () => Math.round(chapTrack.scrollLeft / step());
      const goTo = (i) => chapTrack.scrollTo({ left: i * step(), behavior: 'smooth' });
      const atEnd = () => chapTrack.scrollLeft >= maxScroll() - 4;

      const update = () => {
        const first = Math.min(current(), cards.length - 1);
        const visible = Math.max(1, Math.floor((chapTrack.clientWidth + 16) / step() + 0.05));
        const last = Math.min(first + visible, cards.length);
        count.textContent = 'Bab ' + pad(first + 1) + (last > first + 1 ? '–' + pad(last) : '') + ' dari ' + cards.length;
        bar.style.width = (maxScroll() > 0 ? (chapTrack.scrollLeft / maxScroll()) * 100 : 100) + '%';
      };

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      let timer = null;
      let hold = false;
      const stop = () => { if (timer) { clearInterval(timer); timer = null; } };
      const advance = () => {
        if (hold || document.hidden) return;
        if (atEnd()) chapTrack.scrollTo({ left: 0, behavior: 'smooth' });
        else goTo(Math.min(current() + 1, cards.length - 1));
      };
      const start = () => { stop(); if (!reduce.matches) timer = setInterval(advance, 5000); };
      const pause = () => { hold = true; };
      const resume = () => { hold = false; start(); };

      prev.addEventListener('click', () => { goTo(Math.max(current() - 1, 0)); start(); });
      next.addEventListener('click', () => {
        if (atEnd()) chapTrack.scrollTo({ left: 0, behavior: 'smooth' });
        else goTo(Math.min(current() + 1, cards.length - 1));
        start();
      });
      chapTrack.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      chapBox.addEventListener('mouseenter', pause);
      chapBox.addEventListener('mouseleave', resume);
      chapBox.addEventListener('touchstart', pause, { passive: true });
      chapBox.addEventListener('touchend', resume);
      chapBox.addEventListener('touchcancel', resume);
      chapBox.addEventListener('focusin', pause);
      chapBox.addEventListener('focusout', resume);
      update();
      start();
    }
  </script>
    <script>
    // Isi hanya dengan pembelian ASLI yang pembelinya sudah mengizinkan.
    // Format: { name: 'Nama', city: 'Kota' },
    const orders = [
      { name: 'Umar', city: 'Depok' },
      { name: 'Ridwan', city: 'Tangerang' },
      { name: 'Riska', city: 'Jakarta' },
      { name: 'Citra', city: 'Bekasi' },
    ];
    const PRODUCT = 'Paket Ebook';

    const toast = document.querySelector('#buy-toast');
    if (toast) {
      const nameEl = document.querySelector('#buy-toast-name');
      const timeEl = document.querySelector('#buy-toast-time');
      const closeBtn = document.querySelector('#buy-toast-close');
      let closed = false;
      try { closed = sessionStorage.getItem('buy-toast-closed') === '1'; } catch (e) {}


      let i = 0;
      const show = () => {
        if (closed) return;
        const o = orders[i % orders.length];
        nameEl.textContent = o.name + (o.city ? ' dari ' + o.city : '');
        timeEl.textContent = 'membeli ' + PRODUCT;
        toast.classList.add('is-visible');
        setTimeout(() => toast.classList.remove('is-visible'), 6000);
        i += 1;
        setTimeout(show, 16000);
      };

      closeBtn.addEventListener('click', () => {
        closed = true;
        toast.classList.remove('is-visible');
        try { sessionStorage.setItem('buy-toast-closed', '1'); } catch (e) {}
      });

      if (orders.length) setTimeout(show, 8000);
    }
  </script>
  <script>
    const fbLeaf = document.querySelector('#fb-leaf');
    if (fbLeaf) {
      const fbPrev = document.querySelector('#fb-prev');
      const fbNext = document.querySelector('#fb-next');
      const fbLabel = document.querySelector('#fb-label');
      const fbStage = document.querySelector('.flipbook-stage');
      const setFlip = (flipped) => {
        fbLeaf.classList.toggle('is-flipped', flipped);
        fbLabel.textContent = flipped ? 'Halaman 3 – 4' : 'Halaman 1 – 2';
        fbPrev.disabled = !flipped;
        fbNext.disabled = flipped;
      };
      fbPrev.addEventListener('click', () => setFlip(false));
      fbNext.addEventListener('click', () => setFlip(true));
      fbLeaf.querySelector('.fb-face--front').addEventListener('click', () => setFlip(true));
      fbLeaf.querySelector('.fb-face--back').addEventListener('click', () => setFlip(false));
      let startX = null;
      fbStage.addEventListener('pointerdown', (e) => { startX = e.clientX; });
      fbStage.addEventListener('pointerup', (e) => {
        if (startX === null) return;
        const dx = e.clientX - startX;
        startX = null;
        if (dx < -40) setFlip(true);
        else if (dx > 40) setFlip(false);
      });
      setFlip(false);
    }
  </script>
